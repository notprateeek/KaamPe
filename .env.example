# KaamPe Environment Configuration (validated at startup by server/config/env.ts)
PORT=3001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when GEMINI_MODEL hits its quota (empty = no fallback)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash

# Optional OpenAI fallback (drop-in): used when GEMINI_API_KEY is missing or a Gemini call
# fails (quota, outage). AI_PROVIDER=openai makes OpenAI the first choice instead.
# Google Search grounding and voice transcription stay Gemini-only.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# AI_PROVIDER=gemini

# Optional: exact frontend origin for cross-origin production access.
# Leave unset when Express serves the SPA from the same origin (Render default).
# CORS_ORIGIN=https://your-frontend.example.com

# Optional: reverse-proxy hops to trust for client IPs (default 1 in production, 0 otherwise).
# TRUST_PROXY_HOPS=1

# Rate limiting (fixed window, in-memory, per IP + guest session).
# Defaults: production 120 API / 20 AI+document requests per minute;
# development/test 2000 / 500 so local use and Playwright e2e never trip it.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_API_MAX=120
# RATE_LIMIT_AI_MAX=20

# Note: guest sessions are random server-issued ids (no signing), so no SESSION_SECRET is needed.

# Demo account: "Try demo" signs in to a fresh session pre-filled with 3 weeks of sample data.
# DEMO_LOGIN_ENABLED=true
# DEMO_USERNAME=demo
# DEMO_PASSWORD=kaampe-demo

# Admin panel at /admin (aggregate, anonymised usage stats). In production the panel is
# disabled (404) until ADMIN_PASSWORD is set to something other than the default.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=kaampe-admin
# ADMIN_TOKEN_SECRET=at-least-16-random-characters   # optional; derived from the credentials if unset
