# KaamPe Environment Configuration
PORT=3001
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
SESSION_SECRET=replace_with_a_random_secret_for_your_environment
# Optional: exact frontend origin for cross-origin production access.
# Leave unset when Express serves the SPA from the same origin (Render default).
# CORS_ORIGIN=https://your-frontend.example.com
